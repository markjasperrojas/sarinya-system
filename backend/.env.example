# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>

# Secret key for signing JWT tokens — use a long random string in production
JWT_SECRET=your_jwt_secret_here

# Port the server will listen on (default: 5000)
PORT=5000

# Comma-separated list of allowed frontend origins (leave unset in local dev to allow all)
# Example for production: https://your-app.vercel.app
ALLOWED_ORIGINS=https://your-app.vercel.app
